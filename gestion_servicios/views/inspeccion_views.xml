<odoo>
    <record id="view_servicio_inspeccion_list" model="ir.ui.view">
        <field name="name">servicio.inspeccion.list</field>
        <field name="model">servicio.inspeccion</field>
        <field name="arch" type="xml">
            <list string="Inspecciones de servicio">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="inspection_date"/>
                <field name="technician_id"/>
                <field name="system_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_servicio_inspeccion_form" model="ir.ui.view">
        <field name="name">servicio.inspeccion.form</field>
        <field name="model">servicio.inspeccion</field>
        <field name="arch" type="xml">
            <form string="Inspección de servicio">
                <header>
                    <button name="action_previous_section" type="object"
                            string="Anterior" icon="arrow_back"
                            invisible="section == 'detail'"/>
                    <button name="action_next_section" type="object"
                            string="Siguiente" icon="arrow_forward"
                            class="btn-primary"
                            invisible="section == 'received_by'"/>
                    <button name="action_start_inspection" type="object"
                            string="Iniciar inspección" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_complete_inspection" type="object"
                            string="Completar inspección" class="btn-success"
                            invisible="section != 'received_by' or state == 'done'"/>
                    <button name="action_download_report" type="object"
                            string="Descargar PDF" icon="download" class="btn-primary"
                            invisible="state != 'done'"/>
                    <button name="action_send_email" type="object"
                            string="Enviar por correo" icon="mail" class="btn-primary"
                            invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="section" widget="selection"/>
                        <field name="name" readonly="1"/>
                    </group>

                    <group invisible="section != 'detail'">
                        <separator string="1. Detalle del servicio"/>
                        <field name="report_type"/>
                        <field name="customer_id"/>
                        <field name="location"/>
                        <field name="inspection_date"/>
                        <field name="technician_id"/>
                        <field name="customer_representative"/>
                    </group>

                    <group invisible="section != 'system_type'">
                        <separator string="2. Tipo de sistemas"/>
                        <field name="system_type"/>
                    </group>

                    <!-- SECCIÓN 3: 7 barras desplegables -->
