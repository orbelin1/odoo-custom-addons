<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_inspeccion" model="mail.template">
        <field name="name">Inspección: enviar reporte al cliente</field>
        <field name="model_id" ref="model_servicio_inspeccion"/>
        <field name="subject">Reporte de inspección {{ object.name }}</field>
        <field name="email_from">{{ (object.technician_id.email_formatted or user.email_formatted) }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="partner_to">{{ object.customer_id.id }}</field>
        <field name="report_template_ids" eval="[(4, ref('gestion_servicios.action_report_inspeccion'))]"/>
        <field name="lang">{{ object.customer_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Estimado(a) <t t-out="object.customer_representative or object.customer_id.name or ''"/>:
        <br/><br/>
        Le enviamos adjunto el reporte de inspección
        <strong t-out="object.name or ''"/>
        realizado el <t t-out="object.inspection_date and object.inspection_date.strftime('%d/%m/%Y') or ''"/>
        en <t t-out="object.location or ''"/>.
        <br/><br/>
        Quedamos a sus órdenes para cualquier duda.
        <br/><br/>
        Atentamente,<br/>
        <t t-out="object.technician_id.name or ''"/>
    </p>
</div>
        </field>
    </record>
</odoo>
